<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb fire/configure SOS. Never present in release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jilla.SIMULATE_SOS" />
                <action android:name="com.jilla.CONFIGURE" />
                <action android:name="com.jilla.CANCEL_SOS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
